{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flask (desenvolvimento)",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "env": { "FLASK_APP": "wsgi.py", "FLASK_DEBUG": "1" },
      "args": ["run", "--no-debugger", "--port", "5000"],
      "jinja": true,
      "justMyCode": true
    },
    {
      "name": "Pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "justMyCode": false
    }
  ]
}
