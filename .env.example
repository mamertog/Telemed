# Copie para .env (desenvolvimento). Em produção, configure no painel do Render.
APP_ENV=development

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres

# PostgreSQL (obrigatório). No Render, use a "Internal Database URL".
DATABASE_URL=postgresql://medico:medico@localhost:5432/medico_dev
# Banco exclusivo para testes automatizados (será APAGADO a cada execução)
TEST_DATABASE_URL=postgresql://medico:medico@localhost:5432/medico_test

# Opcional: chave separada para cifrar segredos TOTP (padrão: derivada da SECRET_KEY)
# MFA_ENCRYPTION_KEY=

# URL pública do site (usada nos links dos e-mails)
PUBLIC_BASE_URL=http://127.0.0.1:5000

# E-mail transacional: none | console | resend | brevo
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=Consultório Dra. Juliana Gonçalves Rosa

# Sessão
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

BOOKING_ALERT_EMAIL=julianagrosa97@gmail.com
